APP_ORIGINS=https://dafatii.example
ADMIN_EMAILS=owner@example.com
PASSWORD_RESET_FROM=Dafatii <account@example.com>
RESEND_API_KEY=replace-with-encrypted-secret
MAX_UPLOAD_BYTES=536870912
AUTH_ATTEMPT_LIMIT=10
UPLOAD_INIT_LIMIT=60
USER_STORAGE_QUOTA_BYTES=10737418240
STORAGE_PROVIDER=drive
GOOGLE_DRIVE_CLIENT_ID=SET_AS_A_CLOUDFLARE_ENCRYPTED_SECRET
GOOGLE_DRIVE_CLIENT_SECRET=SET_AS_A_CLOUDFLARE_ENCRYPTED_SECRET
GOOGLE_DRIVE_REFRESH_TOKEN=SET_AS_A_CLOUDFLARE_ENCRYPTED_SECRET
GOOGLE_DRIVE_FOLDER_ID=YOUR_PRIVATE_DAFATII_FOLDER_ID
GOOGLE_TRANSLATE_API_KEY=SET_AS_A_CLOUDFLARE_ENCRYPTED_SECRET
GEMINI_API_KEY=SET_AS_A_CLOUDFLARE_ENCRYPTED_SECRET
GEMINI_MODEL=gemini-3.8-flash
# Bind an R2 bucket to the Pages project as R2_STORAGE for app-owned manifests and generated previews.
GCS_PROJECT_ID=example-project
GCS_BUCKET=dafatii-private-example
GCS_CLIENT_EMAIL=dafatii-storage@example-project.iam.gserviceaccount.com
GCS_PRIVATE_KEY=SET_AS_A_CLOUDFLARE_ENCRYPTED_SECRET
RATE_LIMIT_PEPPER=SET_AS_A_CLOUDFLARE_ENCRYPTED_SECRET
